# --- Serveur ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
# En-têtes Host acceptés sur /mcp, séparés par des virgules.
# À définir derrière un reverse proxy (HAProxy/nginx) : mettez votre FQDN
# public, ex. mcp.monentreprise.fr. Vide = comportement par défaut du SDK
# (bind 127.0.0.1/localhost => seuls les hôtes locaux sont autorisés).
MCP_TRANSPORT_ALLOWED_HOSTS=

# --- Scraping ---
# Délai de connexion/réponse (secondes)
SCRAPE_TIMEOUT=30
# Taille max de réponse acceptée (octets, 10 Mo par défaut)
SCRAPE_MAX_BYTES=10485760
# User-Agent envoyé aux pages cibles
SCRAPE_USER_AGENT="mcp-scraping-server/1.0 (+local-vm)"
# Liste blanche optionnelle (hôtes séparés par des virgules).
# Vide = tous les hôtes. Les sous-domaines des hôtes listés sont autorisés.
SCRAPE_ALLOWED_HOSTS=

# --- TLS (HTTPS) ---
# Bundle CA personnalisé (fichier PEM) pour vérifier les certificats
# HTTPS, par ex. une CA interne d'entreprise. Ce bundle remplace le
# store par défaut : pour conserver aussi les CAs publiques,
# concaténez-y le bundle certifi
# (python -c 'import certifi; print(certifi.where())').
SCRAPE_CA_BUNDLE=
# Si vrai (1/true/yes), ignore la vérification des certificats TLS
# (à réserver aux cas très spécifiques).
SCRAPE_INSECURE=

# --- Sécurité ---
# Token optionnel : si non vide, le client MCP doit envoyer
# Authorization: Bearer <token>
MCP_TOKEN=
